@page
@model TraderGo.Pages.NewDesignModel
@{
    Layout = null;
}
<style>
   * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
        /* font-family: "system-ui,-apple-system","Segoe UI",Roboto,"Helvetica Neue","Noto Sans","Liberation Sans",Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji"; */
    }

    body {
        background: #0d1117 !important;
        color: #fff !important;
    }

    /* Header */
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 4%;
        background: #161b22;
        border-bottom: 1px solid #30363d;
        position: fixed;
        top:0px;
        width:100%;
        z-index: 1;
        opacity:.9;
    }

    .logo {
        font-size: 1.5rem;
        font-weight: bold;
    }
    nav{
        width: 100%;
    }
    nav a {
        color: #c9d1d9;
        text-decoration: none;
        margin-left: 25px;
        transition: 0.3s;
    }

        nav a:hover {
            color: #58a6ff;
        }

    .SearchWrapper {
        width: 40% !important;
    }

.main-container {
    width:100%;
    height:auto;
        margin: 0 auto;
        float:none;
        overflow: hidden;
        position: relative;
        top:80px;
}
    /* Ticker */
    .ticker-container {
        overflow: hidden;
        background: #111827;
        border-bottom: 1px solid #30363d;
    }

    .ticker {
        display: flex;
        gap: 50px;
        white-space: nowrap;
        padding: 12px;
        animation: scroll 25s linear infinite;
    }

    @@keyframes scroll {
        from {
            transform: translateX(100%);
        }

        to {
            transform: translateX(-100%);
        }
    }

    /* Hero */
    .hero {
        text-align: center;
        padding: 80px 20px;
    }

        .hero h1 {
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .hero p {
            color: #8b949e;
            margin-bottom: 25px;
        }

        .hero button {
            padding: 14px 30px;
            border: none;
            border-radius: 8px;
            background: #238636;
            color: white;
            font-size: 1rem;
            cursor: pointer;
        }

            .hero button:hover {
                background: #2ea043;
            }

    /* Market Overview */
    .market-overview {
/*         display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px; */
        /* padding: 40px 8%; */
    }

    .market-card {
        width:200px;
        background: #161b22;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #30363d;
        color:#fff;
        float: left;
        margin-right: 20px;
        margin-left: 20px;
    }

        .market-card p {
            font-size: 1.8rem;
            margin: 10px 0;
        }

    /* Stock Grid */
    .stocks {
        /* padding: 40px 8%; */
    }

        .stocks h2 {
            margin-bottom: 20px;
        }

    .stock-grid {
/*         display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px; */
    }

    .stock-card {
        width: 200px;
        background: #161b22;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #30363d;
        transition: transform 0.3s;
        color: #fff;
        float: left;
        margin-right: 20px;
        margin-left: 20px;
    }

        .stock-card:hover {
            transform: translateY(-5px);
        }

        .stock-card h3 {
            margin-bottom: 8px;
        }

        .stock-card p {
            color: #8b949e;
            margin-bottom: 10px;
        }

    /* Watchlist */
    .watchlist {
        padding: 40px 8%;
    }

        .watchlist h2 {
            margin-bottom: 20px;
        }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #161b22;
        border-radius: 12px;
        overflow: hidden;
        color: #fff;
    }

    th,
    td {
        padding: 16px;
        text-align: left;
    }

    th {
        background: #1f2937;
    }

    tr {
        border-bottom: 1px solid #30363d;
    }

        tr:last-child {
            border-bottom: none;
        }

    /* Utilities */
    .positive {
        color: #3fb950;
        font-weight: bold;
    }

    .negative {
        color: #f85149;
        font-weight: bold;
    }
    #MyChart {
        padding: 40px 8%;
        /* border: 1px solid #000; */
    }   
    /* Footer */
    footer {
        text-align: center;
        padding: 25px;
        margin-top: 40px;
        border-top: 1px solid #30363d;
        color: #8b949e;
    }

</style>
