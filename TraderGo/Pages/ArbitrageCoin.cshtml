@page
@model TraderGo.Pages.ArbitrageCoinModel
@{
    ViewData["Title"] = "Tradergo.com - Arbitrage Coin Info";
    int stockCnt = 1;
    string textColor = string.Empty;
}
<h4 style="color:#006699;">Arbitrage Info</h4>
<div class="row">
    <div class="col">
        @await Html.PartialAsync("~/Pages/Partial/_StockMenu.cshtml")
    </div>
</div>
<div class="border border-1 border-primary rounded-3 overflow-hidden w-100 h-75 p-2 m-2">
    <h6 style="color:#006699;">Movers</h6>
</div>
@* <div style="width:99%;display:flex;overflow-y:auto;margin:0px auto;overflow:hidden;"> *@
@* <div class="d-flex flex-row flex-nowrap overflow-auto py-2"> *@
<div class="row fw-bold bg-info text-light p-0 overflow-auto" style="font-size: 11px;">
    <div class="col border border-1 border-light text-center">&nbsp;</div>
    <div class='col border border-1 border-light text-center'>Symbol</div>
    <div class='col border border-1 border-light text-center'>Name</div>
    @* <div class='col border border-1 border-light text-center'>Exchange</div> *@
    <div class='col border border-1 border-light text-center'>Last Price</div>
    <div class='col border border-1 border-light text-center'>Last Open</div>
    <div class='col border border-1 border-light text-center'>Last Close</div>
    <div class='col border border-1 border-light text-center'>Last Change</div>
    <div class='col border border-1 border-light text-center'>Last Change Percent</div>
    <div class='col border border-1 border-light text-center'>RSI</div>
    <div class='col border border-1 border-light text-center'>VWAP</div>
    <div class='col border border-1 border-light text-center'>Percent Higher</div>
    <div class='col border border-1 border-light text-center'>Percent Lower</div>
    <div class='col border border-1 border-light text-center'>Short Count</div>
    <div class='col border border-1 border-light text-center'>Long Count</div>
</div>
@foreach (var item in Model?.movers)
{
    if (item == null) { continue; }
    if (decimal.Parse(item["lastopChange"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture) < 0)
    {
        textColor = "text-danger";
    }
    else
    {
        textColor = "text-success";
    }
    try
    {
        <div class="row p-0 overflow-auto" style="font-size:11px;">
            <div class="col border border-1 border-info">@stockCnt</div>
            <div class='col border border-1 border-info'><a rel="canonical" href="javascript:objContext.Quote2('@item["Symbol"].ToString()','')" style="color:#006699;text-decoration:none;">@item["Symbol"].ToString()</a></div>
            <div class='col border border-1 border-info'>@item["Name"].ToString()</div>
            @*@<div class='col border border-1 border-info'>@item["Exchange"].ToString()</div>*@
            <div class='col border border-1 border-info'>$@Math.Round(decimal.Parse(item["lastPrice"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)</div>
            <div class='col border border-1 border-info'>$@Math.Round(decimal.Parse(item["lastOpen"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)</div>
            <div class='col border border-1 border-info'>$@Math.Round(decimal.Parse(item["lastClose"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)</div>
            <div class='col border border-1 border-info @textColor'>$$@Math.Round(decimal.Parse(item["lastopChange"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)</div>
            <div class='col border border-1 border-info @textColor'>@Math.Round(decimal.Parse(item["lastopChangePercent"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)%</div>
            <div class='col border border-1 border-info'>@Math.Round(decimal.Parse(item["RSI"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)</div>
            <div class='col border border-1 border-info'>$@Math.Round(decimal.Parse(item["VWAP"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)</div>
            <div class='col border border-1 border-info'>@Math.Round(decimal.Parse(item["PercentHigher"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)%</div>
            <div class='col border border-1 border-info'>@Math.Round(decimal.Parse(item["PercentLower"].ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture), 6)%</div>
            <div class='col border border-1 border-info'>@item["shortCnt"].ToString()</div>
            <div class='col border border-1 border-info'>@item["longCnt"].ToString()</div>
        </div>
        ++stockCnt;
    }
    catch (Exception ex)
    {

    }

}
