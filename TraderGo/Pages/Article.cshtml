@page "{Id?}/{title?}"
@model TraderGo.Pages.ArticleModel
@{
    ViewData["Title"] = "Tradergo.com - Article page";
}
<script type="text/javascript">
    let Id = '@RouteData.Values["Id"]';
    let title = '@RouteData.Values["title"]';
</script>
<style>

    #newsContent .cardNews .card-title {
        font-size:23px !important;
        line-height: 20px;
    }

    #newsContent .cardNews .card-text {
        font-size: 19px !important;
        margin-top: -10px;
        line-height:20px;
    }

    #newsContent .cardNews .card-body {
        height:inherit !important
    }
</style>
<div id="newsContent" class="border rounded-3" style="width:99%;height:auto;margin:0px auto;float:none;position: relative;overflow:hidden;overflow-x:auto;">
    <div class="card mb-3 cardNews">
        <div style="width:100%;height:375px;margin:0px auto;float:none;overflow:hidden;">
            <img id="image" src="..." class="card-img-top" alt="@RouteData.Values["title"]?.ToString()?.Replace("-"," ")" />
        </div>
        <div class="card-body p-5">
            <h5 class="card-title">@RouteData.Values["title"]?.ToString()?.Replace("-", " ")</h5>
            <p class="card-text" id="content"></p>
            <p class="card-text"><small id="published" class="text-muted"></small></p>
        </div>
    </div>
</div>
