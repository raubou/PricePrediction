@using System.Text.Json
@model TraderGo.Pages.AccountInfoModel
@{
    ViewData["Title"] = "Tradergo.com - Account Info";
    string status = string.Empty;
    string bold = string.Empty;
    dynamic? quote = null;
    int stockCnt = 1;
}

@if (!string.IsNullOrEmpty(Model?.AccountInfo?.securitiesAccount?.accountNumber))
{

    <h4 style="color:#006699;">Schwab/Etrade Account Info</h4>
    <div class="row">
        <div class="col">
            @await Html.PartialAsync("~/Pages/Partial/_StockMenu.cshtml")
        </div>
    </div>
    <div class="border border-1 border-primary rounded-3 overflow-hidden w-100 h-75 p-2 m-2">
        <h6 style="color:#006699;">Balances</h6>

        <div class='row bg-info text-light p-0' style="font-size:11px;">
            <div class='col fw-bold border border-1 border-light'>Account Number</div>
            <div class='col fw-bold border border-1 border-light'>Equity</div>
            <div class='col fw-bold border border-1 border-light'>Cash Balance</div>
            <div class='col fw-bold border border-1 border-light'>Available Funds Non Marginable Trade</div>
            <div class="col fw-bold border border-1 border-light">Maintenance Requirement</div>
            <div class='col fw-bold border border-1 border-light'>Long Margin Value</div>
            <div class='col fw-bold border border-1 border-light'>Long Stock Value</div>
            <div class='col fw-bold border border-1 border-light'>Short Margin Value</div>
            <div class='col fw-bold border border-1 border-light'>Short Stock Value</div>
            <div class='col fw-bold border border-1 border-light'>Equity Percentage</div>
        </div>
        <div class="row  p-0" style="font-size:11px;">
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.accountNumber</div>
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.InitialBalances.equity</div>
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.InitialBalances.cashBalance</div>
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.InitialBalances.availableFundsNonMarginableTrade</div>
            <div class="col border border-1 border-info">@Model.AccountInfo.securitiesAccount.InitialBalances.maintenanceRequirement</div>
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.InitialBalances.longMarginValue</div>
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.InitialBalances.longStockValue</div>
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.InitialBalances.shortMarginValue</div>
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.InitialBalances.shortStockValue</div>
            <div class='col border border-1 border-info'>@Model.AccountInfo.securitiesAccount.InitialBalances.equityPercentage</div>
        </div>

    </div>
@*     <div class="border border-1 border-primary rounded-3 overflow-hidden w-100 h-75 p-2 m-2">
        <h6 style="color:#006699;">Token Info</h6>
        <div class='row bg-info text-light p-0' style="font-size:11px;">
            <div class='col fw-bold border border-1 border-light'>Token Type</div>
