    <div class="border border-1 border-primary rounded-3 overflow-hidden w-100 h-75 p-2 m-2">
        <h6 style="color:#006699;">Schwab Positions</h6>
        <div class="row fw-bold p-0" style="font-size:11px;">&nbsp;</div>
        <div class="row fw-bold bg-info text-light p-0" style="font-size: 11px;">
            <div class='col border border-1 border-light text-center'>Number</div>
            <div class='col border border-1 border-light text-center'>Symbol</div>
            <div class='col border border-1 border-light text-center'>Quantity</div>
            <div class='col border border-1 border-light text-center'>Aaverage Price Paid</div>
            <div class='col border border-1 border-light text-center'>Day Gains $</div>
            <div class='col border border-1 border-light text-center'>Day Gains %</div>
            <div class='col border border-1 border-light text-center'>Total Gains $</div>
            <div class='col border border-1 border-light text-center'>Market Value</div>
            <div class='col border border-1 border-light text-center'>Current Price</div>
            <div class="col border border-1 border-light text-center">Last Price</div>
            <div class="col border border-1 border-light text-center">Price Purchased</div>
            <div class="col border border-1 border-light text-center">Percent Difference Price Purchased/Current Price</div>
            <div class="col border border-1 border-light text-center">Percent Difference Last Price/Current Price</div>
            <div class="col border border-1 border-light text-center">Date Purchased</div>
            <div class="col border border-1 border-light text-center">&nbsp;</div>
        </div>
    @if (Model?.AccountInfo != null && Model?.AccountInfo?.securitiesAccount != null && Model?.AccountInfo?.securitiesAccount?.Positions != null)
        @foreach (var item in Model?.AccountInfo?.securitiesAccount?.Positions)
        {
@*             Model.stock = Model.StockTracker.Where(x => x.Symbol == item.Instruments.symbol).FirstOrDefault();
            if (Model.stock == null)
            {
                continue;
            } *@
            <script type="text/javascript">
                $(function() {
                    $(".overlay").hide();
                    objContext.GetQuoteStupid('@Model.stock?.PricePurchased','@Model.stock?.LastPrice','@item.Instruments.symbol','#lastPrice_@Model.stockCnt','#priceDiffPurchased_@Model.stockCnt','#priceDiffCurrent_@Model.stockCnt');
                });
            </script>
            <div class="row" style="font-size:11px;">
                <div class='col border border-1 border-info'>@Model.stockCnt</div>
                @try
                {
                    //
                    <div class='col border border-1 border-info'><a rel="canonical" href="javascript:objContext.GetQuote('@item?.Instruments?.symbol','')" style="color:#006699;text-decoration:none;">@item?.Instruments?.symbol</a></div>
                    @if (Convert.ToDecimal(item?.shortQuantity) > 0)
                    {
                        <div class='col border border-1 border-info'>-@item.shortQuantity</div>
                    }
                    else
                    {
                        <div class='col border border-1 border-info'>@item.longQuantity</div>
                    }

                    <div class='col border border-1 border-info'>$@Math.Round(Convert.ToDecimal(item.averagePrice), 2)</div>
                    @if (Convert.ToDecimal(item.shortQuantity) > 0)
                    {
                        <div class='col border border-1 border-info text-success'>$@Math.Round(Convert.ToDecimal(item.currentDayProfitLoss), 2)</div>
                        <div class='col border border-1 border-info text-success'>@item.currentDayProfitLossPercentage%</div>
                    }
                    else
                    {
                        <div class='col border border-1 border-info text-danger'>$@Math.Round(Convert.ToDecimal(item.currentDayProfitLoss), 2)</div>
                        <div class='col border border-1 border-info text-danger'>@item.currentDayProfitLossPercentage%</div>
                    }


                    @if (Convert.ToDecimal(item.shortQuantity) > 0)
                    {
                        <div class='col border border-1 border-info'> $@Math.Round(Convert.ToDecimal(item.shortOpenProfitLoss), 2)</div>
                    }
                    else
                    {
                        <div class='col border border-1 border-info'>
                            $@Math.Round(Convert.ToDecimal(item.longOpenProfitLoss), 2)
                        </div>
                    }
                    <div class='col border border-1 border-info'>$@item.marketValue</div>
                    <div id="lastPrice_@Model.stockCnt" class="col border border-1">
                    </div>
                    <div class="col border border-1">&nbsp;$@Model.stock?.LastPrice</div>
                    <div class="col border border-1">&nbsp;$@Model.stock?.PricePurchased</div>
                    <div id="priceDiffPurchased_@Model.stockCnt" class="col border border-1 @Model.status">
                    </div>
                    <div id="priceDiffCurrent_@Model.stockCnt" class="col border border-1 @Model.status">
                    </div>

                    <div class='col border border-1 border-info'>&nbsp;@Model.stock?.DatePurchased</div>
                    <div class='col border border-1 border-info'>
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="platform_@item.Instruments.symbol" name="platform" value="1" />
                            <input type="hidden" id="btn_@item.Instruments.symbol" name="symbol" class="btn btn-success" value="@item.Instruments.symbol" />
                            <input type="submit" class="btn btn-success" value="Sell" />
                        </form>
                    </div>

                }
                catch (Exception ex)
                {
                    Html.Raw(ex.Message);
                }
            </div>

            ++Model.stockCnt;
        }

        <div class="border border-1 border-primary rounded-3 overflow-hidden w-100  p-2 m-2">
            <p><a target="_blank" href="https://api.schwabapi.com/v1/oauth/authorize?response_type=code&client_id=@Uri.EscapeDataString(Model.clientSecret)&scope=readonly&redirect_uri=https://127.0.0.1/SchwabAPICallBack">Authorize Schwab</a></p>
        </div>
    </div>
