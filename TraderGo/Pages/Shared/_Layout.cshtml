            <img id="btnClose" src="../../img/history.png" title="Price History" alt="Price History" onclick="objContext.StockInfo(3)" height="20" />
            <img id="btnClose" src="../../img/news.png" title="News" alt="News" onclick="objContext.StockInfo(4)" height="20" />
            <img id="btnClose" src="../../img/chart.png" title="Chart" alt="Chart" onclick="objContext.StockInfo(5)" height="25" />
