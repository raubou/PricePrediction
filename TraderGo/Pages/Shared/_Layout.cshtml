        <div id="infoWindowTextCenter" style="width:99%;height:400px;margin:0px auto;float:left;overflow:hidden;overflow-x:hidden;overflow-y:auto;display:none;line-height:25px;"></div>
        <div id="infoWindowTextRight" style="width:99%;height:400px;margin:0px auto;float:left;overflow:hidden;overflow-x:hidden;overflow-y:auto;display:none;line-height:25px;"></div>
