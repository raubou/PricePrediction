                    <div class="col">Start Date</div>
                    <div class="col-8"><input id="startDateHistory" type="datetime-local" class="form-control form-control-sm" /></div>
                </div>
                <div class="row mb-1">
                    <div class="col">End End</div>
                    <div class="col-8"><input id="endDateHistory" type="datetime-local" class="form-control form-control-sm" /></div>
                </div>
                <div class="row">
                    <div id="historyMess" class="col fw-bold text-danger"></div>
                    <div class="col text-end">
                        <button type="button" id="btnAddToList" class="btn btn-success circle-button_dashboard">Add to List</button>
                    </div>
                    <div class="col text-end">
                        <button type="button" id="searchHistory" class="btn btn-primary close_button_round">History</button>
                    </div>
                </div>
            </div>
