                <div class="row mb-1">
                    <div class="col">Period Type</div>
                    <div class="col-8">
                        <select id="PeriodType" class="form-select form-select-sm">
                            <option value="">--</option>
                            <option value="day">day</option>
                            <option value="month">month</option>
                            <option value="year">year</option>
                            <option value="ytd">ytd</option>
                        </select>
                    </div>
                </div>
